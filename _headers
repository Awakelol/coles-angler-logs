# Cache headers for Netlify and Cloudflare Pages (both read this file).
# Vercel uses vercel.json instead — keep the two in sync.
#
# The service worker and the shell must never be cached by the CDN or the
# browser, or a deploy won't be noticed. Everything else is safe to cache
# hard, because sw.js is network-first for code and will refetch anyway.

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
